  "CalculatedFields": [
    {
      "DataSetIdentifier": "sesds",
      "Name": "dkim_ok",
      "Expression": "ifelse({dkim_status}='SUCCESS',1,0)"
    },
    {
      "DataSetIdentifier": "sesds",
      "Name": "needs_attention",
      "Expression": "ifelse(verified=0 OR ({identity_type}='DOMAIN' AND {dkim_status}<>'SUCCESS'),1,0)"
    }
